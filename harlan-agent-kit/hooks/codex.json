{
  "description": "Run the same Bash guards as the Claude Code plugin manifest, in the same order.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pnpm-only.sh",
            "timeout": 10,
            "statusMessage": "Checking package manager"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/wt-only.sh",
            "timeout": 10,
            "statusMessage": "Checking worktree command"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/himalaya-read-only.sh",
            "timeout": 10,
            "statusMessage": "Checking email access"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pr-skill-only.sh",
            "timeout": 10,
            "statusMessage": "Checking pull request command"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/github-read-routing.sh",
            "timeout": 10,
            "statusMessage": "Checking GitHub read account"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/cf-d1-routing.sh",
            "timeout": 10,
            "statusMessage": "Checking D1 query tool"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/merged-branch-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking for a merged branch"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-push.sh",
            "timeout": 10,
            "statusMessage": "Adding the commit format"
          }
        ]
      }
    ]
  }
}
