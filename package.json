{
  "name": "harlan-agent-kit",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm --filter harlan-github-agent build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter harlan-github-agent test:run",
    "typecheck": "pnpm --filter harlan-github-agent typecheck",
    "check:context": "scripts/check-agent-context.sh",
    "service:update": "bash scripts/service.sh update",
    "service:restart": "bash scripts/service.sh restart",
    "service:status": "bash scripts/service.sh status",
    "test:worktree-claim": "bash harlan-agent-kit/scripts/worktree-claim.test.sh",
    "test:wt-only": "bash harlan-agent-kit/hooks/wt-only.test.sh",
    "release": "node --experimental-strip-types scripts/release.ts"
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-harlanzw": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
