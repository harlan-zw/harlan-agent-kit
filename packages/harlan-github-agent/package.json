{
  "name": "harlan-github-agent",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Local service for Harlan's GitHub agents.",
  "license": "MIT",
  "exports": {
    "./terminal-lock": "./dist/terminal-lock.mjs",
    "./terminal": {
      "types": "./dist/terminal.d.mts",
      "import": "./dist/terminal.mjs"
    },
    "./repair-regression-reporter": {
      "types": "./dist/repair-regression-reporter.d.mts",
      "import": "./dist/repair-regression-reporter.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "harlan-terminal": "./dist/terminal-cli.mjs",
    "harlan-github-agent": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter ghostty-terminal-bindings build && pnpm dashboard:build && obuild && node security/build.ts dist/emergency",
    "dashboard:build": "nuxt generate dashboard",
    "dashboard:dev": "nuxt dev dashboard",
    "dev": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/cli.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit && nuxt typecheck dashboard"
  },
  "dependencies": {
    "@coldtea/pr-lens-renderer": "catalog:",
    "@coldtea/pr-lens-schema": "catalog:",
    "@fontpkg/unifont": "catalog:",
    "@openai/codex-sdk": "catalog:",
    "@pierre/diffs": "catalog:",
    "@resvg/resvg-js": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "advocaat": "workspace:*",
    "citty": "catalog:",
    "consola": "catalog:",
    "esbuild": "catalog:",
    "ghostty-terminal-bindings": "workspace:*",
    "h3": "catalog:",
    "image-size": "catalog:",
    "node-pty": "catalog:",
    "octokit": "catalog:",
    "saxes": "catalog:",
    "srvx": "catalog:",
    "typescript": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/octicon": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "@nuxt/fonts": "catalog:",
    "@nuxt/icon": "catalog:",
    "@nuxt/ui": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "marked": "catalog:",
    "node-gyp": "catalog:",
    "nuxt": "catalog:",
    "nuxt-skew-protection": "catalog:",
    "obuild": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
