#!/bin/sh
set -eu

package_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
import_line="import $package_root/Caddyfile"
hosts_line='127.0.0.1 harlan-github-agent.local'

if ! grep -qxF "$import_line" /etc/caddy/Caddyfile; then
  cp --update=none /etc/caddy/Caddyfile /etc/caddy/Caddyfile.before-harlan-github-agent
  printf '\n%s\n' "$import_line" >> /etc/caddy/Caddyfile
fi

if ! grep -qxF "$hosts_line" /etc/hosts; then
  cp --update=none /etc/hosts /etc/hosts.before-harlan-github-agent
  printf '\n%s\n' "$hosts_line" >> /etc/hosts
fi

setfacl -m u:caddy:--x /home/harlan
install -Dm644 "$package_root/assets/caddy.service.conf" /etc/systemd/system/caddy.service.d/harlan-github-agent.conf
systemctl daemon-reload
runuser -u caddy -- caddy validate --config /etc/caddy/Caddyfile
systemctl restart caddy
