#!/usr/bin/python3

import fcntl
import json
import os
import re
import subprocess
import threading
import time
import webbrowser
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from urllib.parse import urlparse

import gi

gi.require_version('AyatanaAppIndicator3', '0.1')
gi.require_version('Gtk', '3.0')
from gi.repository import AyatanaAppIndicator3, GLib, Gtk

RUNNER_LABEL = 'com.harlanzw.desktop-runner=true'
RUNNER_HOSTS_ENV = 'HARLAN_GITHUB_RUNNER_HOSTS'
JOBS_REFRESH_SECONDS = 15
STATUS_URL = os.environ.get('HARLAN_HOGWILD_STATUS_URL', 'https://hogwild.tailcad325.ts.net/').rstrip('/') + '/'
RUNNER_ICON = Path(__file__).resolve().parent.parent / 'assets/github-runner-icon.svg'


def parse_labels(value):
    return dict(label.split('=', 1) for label in value.split(',') if '=' in label)


def parse_runner_hosts(value):
    hosts = []
    names = set()
    for definition in value.split(','):
        name, separator, docker_host = definition.strip().partition('=')
        name = name.strip()
        docker_host, control_separator, control_value = docker_host.strip().partition('|')
        docker_host = docker_host.strip()
        if not separator or not name or not docker_host:
            raise ValueError('Each self-hosted runner location must use Name=Docker URL.')
        if name in names:
            raise ValueError(f'Self-hosted runner location {name} appears more than once.')
        names.add(name)
        host = {'name': name, 'dockerHost': docker_host}
        if control_separator:
            scope, scope_separator, unit = control_value.strip().partition(':')
            if scope not in ('system', 'user') or not scope_separator or not re.fullmatch(r'[A-Za-z0-9@_.-]+\.service', unit):
                raise ValueError(f'Self-hosted runner control for {name} must use system:UNIT.service or user:UNIT.service.')
            host['control'] = {'scope': scope, 'unit': unit}
        hosts.append(host)
    if not hosts:
        raise ValueError('Configure at least one self-hosted runner location.')
    return hosts


def host_systemctl_command(host, action):
    control = host.get('service') or host.get('control')
    if control is not None and control.get('configuration') is not None:
        control = control['configuration']
    if control is None:
        raise ValueError(f"{host['name']} has no self-hosted runner service control.")

    docker_url = urlparse(host['dockerHost'])
    prefix = []
    if docker_url.scheme == 'ssh':
        if docker_url.hostname is None:
            raise ValueError(f"{host['name']} has an invalid SSH Docker URL.")
        target = f'{docker_url.username}@{docker_url.hostname}' if docker_url.username else docker_url.hostname
        prefix = ['ssh']
        if docker_url.port is not None:
            prefix.extend(['-p', str(docker_url.port)])
        prefix.append(target)
    elif docker_url.scheme != 'unix':
        raise ValueError(f"{host['name']} service control requires an SSH or Unix Docker URL.")

    systemctl = ['sudo', '-n', 'systemctl'] if control['scope'] == 'system' else ['systemctl', '--user']
    return [*prefix, *systemctl, action, control['unit']]


def request_host_control(host, run=subprocess.run):
    command = host_systemctl_command(host, 'is-active')
    completed = run(command, check=False, capture_output=True, text=True, timeout=4)
    status = completed.stdout.strip()
    if status not in ('active', 'activating', 'deactivating', 'inactive', 'failed'):
        message = completed.stderr.strip() or status or 'Service status unavailable'
        return {'configuration': host['control'], 'status': 'unavailable', 'message': message}
    return {'configuration': host['control'], 'status': status}


def set_host_accepting_jobs(host, accepting, run=subprocess.run):
    action = 'start' if accepting else 'stop'
    command = host_systemctl_command(host, action)
    command.insert(-1, '--no-block')
    run(command, check=True, capture_output=True, text=True, timeout=4)


def runner_activity(runner, logs):
    if runner.get('State', '').lower() != 'running':
        return {'_tag': 'Offline', 'detail': runner.get('Status', 'Container stopped')}
    for line in reversed(logs.splitlines()):
        if 'Listening for Jobs' in line or 'completed with result:' in line:
            return {'_tag': 'Idle'}
        if 'Running job:' in line:
            return {'_tag': 'Running', 'job': line.split('Running job:', 1)[1].strip()}
    return {'_tag': 'Starting'}


def request_runners(host, run=None):
    run = run or subprocess.run
    docker = ['docker', '--host', host['dockerHost']]
    completed = run(
        [*docker, 'ps', '--all', '--filter', f'label={RUNNER_LABEL}', '--format', '{{json .}}'],
        check=True,
        capture_output=True,
        text=True,
        timeout=4,
    )
    listed_runners = []
    for line in completed.stdout.splitlines():
        if not line:
            continue
        listed_runners.append(json.loads(line))

    def read_runner(runner):
        if runner.get('State', '').lower() != 'running':
            activity = runner_activity(runner, '')
        else:
            logs = run(
            [*docker, 'logs', '--tail', '80', runner['ID']],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
            if logs.returncode != 0 and 'no such container' in logs.stderr.lower():
                return None
            activity = runner_activity(runner, logs.stdout + logs.stderr) if logs.returncode == 0 else {
                '_tag': 'Unknown',
                'detail': logs.stderr.strip() or 'Runner logs unavailable',
            }
        return {
            **runner,
            'Activity': activity,
            'RunnerLabels': parse_labels(runner.get('Labels', '')),
            'Host': host['name'],
        }

    if not listed_runners:
        return []
    with ThreadPoolExecutor(max_workers=min(8, len(listed_runners))) as executor:
        return [runner for runner in executor.map(read_runner, listed_runners) if runner is not None]


def request_runner_host(host):
        control = None
        if host.get('control') is not None:
            try:
                control = request_host_control(host)
            except Exception as caught:
                control = {
                    'configuration': host['control'],
                    'status': 'unavailable',
                    'message': str(caught),
                }
        try:
            result = {
                '_tag': 'Available',
                'name': host['name'],
                'runners': request_runners(host),
            }
        except Exception as caught:
            result = {
                '_tag': 'Unavailable',
                'name': host['name'],
                'message': (caught.stderr.strip() if isinstance(caught, subprocess.CalledProcessError)
                            and caught.stderr else str(caught)),
            }
        if control is not None:
            result['dockerHost'] = host['dockerHost']
            result['service'] = host['control']
            result['control'] = control
        return result


def request_runner_hosts(hosts):
    if not hosts:
        return []
    with ThreadPoolExecutor(max_workers=len(hosts)) as executor:
        return list(executor.map(request_runner_host, hosts))


def read_runner_source(fetch_runner_hosts):
    try:
        return {'_tag': 'Available', 'hosts': fetch_runner_hosts()}
    except Exception as caught:
        return {'_tag': 'Unavailable', 'message': str(caught)}


def merge_runner_source(previous, current, now=None):
    now = time.monotonic() if now is None else now
    if current['_tag'] == 'Unavailable':
        if previous is None or previous['_tag'] != 'Available':
            return current
        return {
            '_tag': 'Available',
            'hosts': [{
                **host,
                'stale': {
                    'message': current['message'],
                    'observedAt': host.get('observedAt', now),
                },
            } for host in previous['hosts']],
        }

    previous_hosts = {
        host['name']: host
        for host in previous.get('hosts', [])
    } if previous is not None and previous['_tag'] == 'Available' else {}
    hosts = []
    for host in current['hosts']:
        if host['_tag'] == 'Available':
            hosts.append({**host, 'observedAt': now})
            continue
        last_known = previous_hosts.get(host['name'])
        if last_known is None or last_known['_tag'] != 'Available':
            hosts.append(host)
            continue
        hosts.append({
            **last_known,
            **{key: value for key, value in host.items() if key in ('dockerHost', 'service', 'control')},
            'stale': {
                'message': host['message'],
                'observedAt': last_known.get('observedAt', now),
            },
        })
    return {'_tag': 'Available', 'hosts': hosts}


def request_runner_snapshot_raw(host, run):
    docker_url = urlparse(host['dockerHost'])
    system = host.get('control', {}).get('scope') == 'system'
    path = '/run/github-runner/harlan-desktop-github-runner/status.json' if system else str(
        Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')) / 'harlan-desktop-github-runner/status.json'
    )
    command = ['cat', '--', path]
    if docker_url.scheme == 'ssh':
        if docker_url.hostname is None or not system:
            raise ValueError('The remote runner snapshot requires system service control.')
        target = f'{docker_url.username}@{docker_url.hostname}' if docker_url.username else docker_url.hostname
        prefix = ['ssh']
        if docker_url.port is not None:
            prefix.extend(['-p', str(docker_url.port)])
        command = [*prefix, target, 'sudo', '-n', *command]
    elif docker_url.scheme != 'unix':
        raise ValueError('The runner snapshot requires an SSH or Unix Docker URL.')
    completed = run(command, check=True, capture_output=True, text=True, timeout=8)
    snapshot = json.loads(completed.stdout)
    if not isinstance(snapshot, dict):
        raise ValueError('The runner snapshot is invalid.')
    return snapshot


def request_runner_snapshot(host, run):
    snapshot = request_runner_snapshot_raw(host, run)
    if not isinstance(snapshot.get('workflowJobs'), list):
        raise ValueError('The runner snapshot has no workflow jobs.')
    return snapshot['workflowJobs']


def format_gib(byte_count):
    gib = byte_count / (1024 ** 3)
    rounded = round(gib, 1)
    return f'{int(rounded)}' if rounded == int(rounded) else f'{rounded:.1f}'


def format_elapsed(started_at_ms, now=None):
    now_ms = (time.time() if now is None else now) * 1000
    seconds = max(0, int((now_ms - started_at_ms) // 1000))
    if seconds >= 3600:
        return f'{seconds // 3600}h {(seconds % 3600) // 60}m'
    if seconds >= 60:
        return f'{seconds // 60}m {seconds % 60}s'
    return f'{seconds}s'


def describe_pool_hold(hold):
    if not isinstance(hold, dict):
        return None
    tag = hold.get('_tag')
    if tag == 'NotHeld':
        return None
    if tag == 'AtMaximum':
        return ('At pool limit', f"{hold.get('live', 0)}/{hold.get('maximum', 0)} active")
    if tag == 'CpuBudget':
        return ('CPU budget', f"{hold.get('inFlightCpu', 0)}/{hold.get('budgetCpu', 0)} CPU, needs {hold.get('poolCpu', 0)}")
    if tag == 'MemoryBudget':
        return (
            'Memory budget',
            f"{format_gib(hold.get('inFlightBytes', 0))}/{format_gib(hold.get('budgetBytes', 0))} GiB, needs {format_gib(hold.get('poolBytes', 0))} GiB",
        )
    if tag == 'MemoryHeadroom':
        return (
            'Memory headroom',
            f"{format_gib(hold.get('availableBytes', 0))} GiB free, keeps {format_gib(hold.get('headroomBytes', 0))} GiB",
        )
    if tag == 'MemoryUnknown':
        return ('Memory unknown', 'host memory unavailable')
    if tag == 'DemandUnavailable':
        return ('Demand unavailable', 'could not read queue')
    if tag == 'HoldUnreadable':
        return ('Held', 'unreadable hold state')
    return None


def parse_runner_snapshot_details(snapshot):
    if not isinstance(snapshot, dict):
        return None
    budgets = snapshot.get('budgets')
    pools = snapshot.get('pools')
    if not isinstance(budgets, dict) or not isinstance(pools, list):
        return None
    cpu_budget = budgets.get('cpu')
    mem_budget_bytes = budgets.get('memoryBytes')
    headroom_bytes = budgets.get('memoryHeadroomBytes')
    if not all(isinstance(value, (int, float)) and not isinstance(value, bool) for value in (cpu_budget, mem_budget_bytes, headroom_bytes)):
        return None

    cpu_reserved = 0
    mem_reserved_bytes = 0
    held_pools = []
    for pool in pools:
        if not isinstance(pool, dict):
            continue
        live = pool.get('live', 0) if isinstance(pool.get('live'), int) else 0
        cpu_per = pool.get('cpuPerRunner', 0) if isinstance(pool.get('cpuPerRunner'), int) else 0
        mem_unit = pool.get('memoryLimitBytes', pool.get('memoryReservationBytes', 0))
        mem_res = mem_unit if isinstance(mem_unit, (int, float)) else 0
        cpu_reserved += live * cpu_per
        mem_reserved_bytes += live * mem_res
        hold = pool.get('hold')
        described = describe_pool_hold(hold)
        queued = pool.get('queued', 0) if isinstance(pool.get('queued'), int) else 0
        if described is not None and not (isinstance(hold, dict) and hold.get('_tag') == 'AtMaximum' and queued == 0):
            held_pools.append({
                'name': pool.get('name') or pool.get('repository') or 'Runner pool',
                'repository': pool.get('repository'),
                'label': described[0],
                'detail': described[1],
                'queued': queued,
            })

    runner_started_at = {}
    for runner in snapshot.get('runners', []):
        if not isinstance(runner, dict):
            continue
        name = runner.get('name')
        job = runner.get('job')
        if isinstance(name, str) and isinstance(job, dict) and isinstance(job.get('startedAt'), (int, float)):
            runner_started_at[name] = job['startedAt']

    return {
        'cpuReserved': cpu_reserved,
        'cpuBudget': int(cpu_budget),
        'memoryReservedGiB': format_gib(mem_reserved_bytes),
        'memoryBudgetGiB': format_gib(mem_budget_bytes),
        'memoryHeadroomGiB': format_gib(headroom_bytes),
        'heldPools': held_pools,
        'runnerStartedAt': runner_started_at,
    }


def request_host_snapshots(hosts, on_error=None, run=None, now=None):
    run = run or subprocess.run
    now = time.time() if now is None else now
    observations = {}
    failures = {}
    capacities = {}

    def fetch(host):
        return host, request_runner_snapshot_raw(host, run)

    with ThreadPoolExecutor(max_workers=max(1, len(hosts))) as executor:
        futures = [executor.submit(fetch, host) for host in hosts]
        for host, future in zip(hosts, futures):
            try:
                _, snapshot = future.result()
            except Exception as caught:
                if on_error is not None:
                    on_error(f"{host['name']} · Jobs unavailable · {caught}")
                continue
            details = parse_runner_snapshot_details(snapshot)
            if details is not None:
                capacities[host['name']] = details
            rows = snapshot.get('workflowJobs')
            if not isinstance(rows, list):
                if on_error is not None:
                    on_error(f"{host['name']} · Jobs unavailable · The runner snapshot has no workflow jobs.")
                continue
            for row in rows:
                try:
                    observation = parse_workflow_observation(row, now)
                    repository = observation['repository']
                    if observation['_tag'] == 'Unavailable':
                        failures[repository] = observation['reason']
                        continue
                    previous = observations.get(repository)
                    if previous is None or observation['observedAt'] > previous['observedAt']:
                        observations[repository] = observation
                except Exception as caught:
                    if on_error is not None:
                        on_error(f"{host['name']} · Jobs unavailable · {caught}")
    if on_error is not None:
        for repository, reason in failures.items():
            if repository not in observations:
                on_error(f'{repository} · Jobs unavailable · {reason}')
    jobs = [job for observation in observations.values() for job in observation['jobs']]
    return jobs, capacities


def parse_workflow_observation(observation, now):
    if not isinstance(observation, dict) or not isinstance(observation.get('repository'), str):
        raise ValueError('The runner job observation is invalid.')
    repository = observation['repository']
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repository):
        raise ValueError('The runner job repository is invalid.')
    if observation.get('_tag') == 'Unavailable':
        if not isinstance(observation.get('reason'), str):
            raise ValueError('The runner job error is invalid.')
        return observation
    observed_at = observation.get('observedAt')
    if observation.get('_tag') != 'Available' or type(observed_at) not in (int, float) or not isinstance(observation.get('jobs'), list):
        raise ValueError('The runner job observation is invalid.')
    if not now * 1000 - 600000 <= observed_at <= now * 1000 + 60000:
        raise ValueError('The runner job observation is stale.')
    for job in observation['jobs']:
        if not isinstance(job, dict) or job.get('_tag') not in ('Queued', 'Running') or job.get('repository') != repository:
            raise ValueError('The runner workflow job is invalid.')
        if type(job.get('id')) is not int or job['id'] <= 0 or not all(isinstance(job.get(key), str) for key in ('name', 'workflow', 'url')):
            raise ValueError('The runner workflow job is invalid.')
        url = urlparse(job['url'])
        if url.scheme != 'https' or url.hostname != 'github.com' or url.username is not None or url.password is not None:
            raise ValueError('The runner workflow job URL is invalid.')
    return observation


def request_workflow_jobs(hosts, on_error=None, run=None, now=None):
    run = run or subprocess.run
    now = time.time() if now is None else now
    observations = {}
    failures = {}
    for host in hosts:
        try:
            rows = request_runner_snapshot(host, run)
        except Exception as caught:
            if on_error is not None:
                on_error(f"{host['name']} · Jobs unavailable · {caught}")
            continue
        for row in rows:
            try:
                observation = parse_workflow_observation(row, now)
                repository = observation['repository']
                if observation['_tag'] == 'Unavailable':
                    failures[repository] = observation['reason']
                    continue
                previous = observations.get(repository)
                if previous is None or observation['observedAt'] > previous['observedAt']:
                    observations[repository] = observation
            except Exception as caught:
                if on_error is not None:
                    on_error(f"{host['name']} · Jobs unavailable · {caught}")
    if on_error is not None:
        for repository, reason in failures.items():
            if repository not in observations:
                on_error(f'{repository} · Jobs unavailable · {reason}')
    return [job for observation in observations.values() for job in observation['jobs']]


def source_runners(source):
    if source['_tag'] != 'Available':
        return []
    return [
        runner
        for host in source['hosts']
        if host['_tag'] == 'Available'
        for runner in host['runners']
    ]


def counted(count, singular, plural=None):
    return f'{count} {singular if count == 1 else plural or f"{singular}s"}'


def runner_label(runner, started_at_ms=None, now=None):
    labels = runner['RunnerLabels']
    repository = labels.get('com.harlanzw.desktop-runner.repository', 'Unknown repository')
    name = runner.get('Names') or labels.get('com.harlanzw.desktop-runner.pool', 'runner')
    activity = runner['Activity']
    marker = {
        'Idle': '⚪',
        'Offline': '🔴',
        'Running': '🟢',
        'Starting': '🟡',
        'Unknown': '🟠',
    }.get(activity['_tag'], '🟠')
    if activity['_tag'] == 'Running':
        elapsed = '' if started_at_ms is None else f' · {format_elapsed(started_at_ms, now)}'
        return f"{marker} Running · {activity['job']}{elapsed} · {repository} · {name}"
    if activity['_tag'] == 'Offline':
        return f"{marker} Offline · {repository} · {name} · {activity['detail']}"
    if activity['_tag'] == 'Unknown':
        return f'{marker} Status unavailable · {repository} · {name}'
    return f"{marker} {activity['_tag']} · {repository} · {name}"


def github_actions_status_label(runners, error):
    if error is not None:
        return '🔴 Status unavailable'
    if not runners:
        return '⚪ No self-hosted runners found'

    counts = {}
    for runner in runners:
        state = runner.get('Activity', {}).get('_tag', 'Unknown')
        counts[state] = counts.get(state, 0) + 1

    if counts.get('Offline', 0) > 0:
        marker = '🔴'
    elif counts.get('Unknown', 0) > 0:
        marker = '🟠'
    elif counts.get('Starting', 0) > 0:
        marker = '🟡'
    elif counts.get('Running', 0) > 0:
        marker = '🟢'
    else:
        marker = '⚪'

    states = []
    for state, label in (
        ('Running', 'running'),
        ('Idle', 'idle'),
        ('Starting', 'starting'),
        ('Offline', 'offline'),
        ('Unknown', 'unknown'),
    ):
        if counts.get(state, 0) > 0:
            states.append(f'{counts[state]} {label}')
    return ' · '.join((f'{marker} {counted(len(runners), "self-hosted runner")}', *states))


def runner_host_status_label(host, now=None):
    if host['_tag'] == 'Unavailable':
        return f"🔴 {host['name']} · unavailable · {host['message'][:100]}"
    status = github_actions_status_label(host['runners'], None)
    marker, detail = status.split(' ', 1)
    capacity = host.get('capacity')
    if host.get('stale') is not None:
        now = time.monotonic() if now is None else now
        age = max(0, int(now - host['stale']['observedAt']))
        return f"🟠 {host['name']} · last known status {age}s old · {detail}"
    if isinstance(capacity, dict):
        running = sum(runner.get('Activity', {}).get('_tag') == 'Running' for runner in host['runners'])
        held = len(capacity.get('heldPools', []))
        if held > 0 and marker == '⚪':
            marker = '🟠'
        activity = f'{running} running' if running > 0 else ('idle' if not host['runners'] else detail)
        parts = [
            f"{marker} {host['name']}",
            activity,
            f"{capacity['memoryReservedGiB']}/{capacity['memoryBudgetGiB']} GiB",
            f"{capacity['cpuReserved']}/{capacity['cpuBudget']} CPU",
        ]
        if held > 0:
            parts.append(f'{held} held')
        return ' · '.join(parts)
    return f"{marker} {host['name']} · {detail}"


def held_pool_label(pool, host_name=None):
    prefix = f'{host_name} · ' if host_name else ''
    queued = f" · {pool['queued']} queued" if pool.get('queued', 0) > 0 else ''
    return f"🟠 {prefix}{pool['name']} · {pool['label']} ({pool['detail']}){queued}"


def menu_item(label, url=None, enabled=True):
    item = Gtk.MenuItem(label=label)
    item.set_sensitive(enabled)
    if url is not None:
        item.connect('activate', lambda *_args: webbrowser.open(url))
    return item


def submenu_item(label, items):
    item = Gtk.MenuItem(label=label)
    submenu = Gtk.Menu()
    for child in items:
        submenu.append(child)
    item.set_submenu(submenu)
    return item


def section_item(label):
    item = Gtk.MenuItem()
    text = Gtk.Label()
    text.set_markup(f'<b>{GLib.markup_escape_text(label)}</b>')
    text.set_xalign(0)
    item.add(text)
    item.set_sensitive(False)
    return item


def separator():
    return Gtk.SeparatorMenuItem()


def runner_error(source):
    if source['_tag'] == 'Unavailable':
        return source['message']
    if source['_tag'] == 'Loading':
        return None
    if source['hosts'] and all(host['_tag'] == 'Unavailable' for host in source['hosts']):
        return 'All runner hosts unavailable'
    return None


def workflow_job_label(job):
    marker = '🟡' if job['_tag'] == 'Queued' else '🟢'
    return f"{marker} {job['repository']} · {job['workflow']} · {job['name']}"


def job_menu(label, jobs):
    if not jobs:
        return menu_item(f'{label} · 0', enabled=False)
    items = [menu_item(workflow_job_label(job), job['url']) for job in jobs[:15]]
    if len(jobs) > 15:
        items.append(menu_item(f'Open Hogwild status for {len(jobs) - 15} more', STATUS_URL))
    return submenu_item(f'{label} · {len(jobs)}', items)


def host_control_status_label(control):
    status = control['status']
    if status == 'active':
        return '🟢 Accepting new jobs'
    if status == 'activating':
        return '🟡 Starting'
    if status == 'deactivating':
        return '🟡 Finishing current jobs'
    if status == 'inactive':
        return '⚪ Not accepting new jobs'
    if status == 'failed':
        return '🔴 Service failed'
    return f"🔴 Service unavailable · {control.get('message', 'Status unavailable')[:80]}"


def confirm_stop_accepting_jobs(host, set_accepting):
    dialog = Gtk.MessageDialog(
        transient_for=None,
        flags=0,
        message_type=Gtk.MessageType.WARNING,
        buttons=Gtk.ButtonsType.CANCEL,
        text=f"Stop accepting new jobs on {host['name']}?",
    )
    dialog.format_secondary_text('Current jobs finish. Queued jobs wait for another self-hosted runner.')
    dialog.add_button('Stop accepting', Gtk.ResponseType.OK)
    response = dialog.run()
    dialog.destroy()
    if response == Gtk.ResponseType.OK:
        set_accepting(host, False)


def build_menu(indicator, source, jobs_source, action_error, refresh, set_accepting):
    menu = Gtk.Menu()
    error = runner_error(source)
    runners = source_runners(source)
    hosts = source['hosts'] if source['_tag'] == 'Available' else []
    status = '🟡 Loading…' if source['_tag'] == 'Loading' else github_actions_status_label(runners, error)

    menu.append(section_item('GitHub Actions'))
    menu.append(menu_item(status, enabled=False))
    if error is not None:
        menu.append(menu_item(error[:100], enabled=False))
    if action_error is not None:
        menu.append(menu_item(action_error[:100], enabled=False))
    menu.append(menu_item('Open Hogwild status', STATUS_URL))

    menu.append(separator())
    if jobs_source['_tag'] == 'Loading':
        menu.append(menu_item('Queued jobs · Loading…', enabled=False))
    elif jobs_source['_tag'] == 'Unavailable':
        menu.append(menu_item('Queued jobs · unavailable', enabled=False))
        menu.append(menu_item(jobs_source['message'][:100], enabled=False))
    else:
        queued_jobs = [job for job in jobs_source['jobs'] if job['_tag'] == 'Queued']
        menu.append(job_menu('Queued jobs', queued_jobs))
        for message in jobs_source.get('errors', []):
            menu.append(menu_item(message[:100], enabled=False))

    all_held = [
        (host['name'], pool)
        for host in hosts
        if host['_tag'] == 'Available' and isinstance(host.get('capacity'), dict)
        for pool in host['capacity'].get('heldPools', [])
    ]
    if all_held:
        menu.append(submenu_item(
            f'🟠 Held pools · {len(all_held)}',
            [
                menu_item(
                    held_pool_label(pool, host_name),
                    None if not pool.get('repository') else f"https://github.com/{pool['repository']}/actions",
                    enabled=bool(pool.get('repository')),
                )
                for host_name, pool in all_held
            ],
        ))

    if hosts:
        menu.append(separator())
        menu.append(section_item('Hosts'))
    for host in hosts:
        control = host.get('control')
        capacity = host.get('capacity') if host['_tag'] == 'Available' else None
        if control is None and capacity is None and (host['_tag'] == 'Unavailable' or not host['runners']):
            menu.append(menu_item(runner_host_status_label(host), enabled=False))
            continue
        items = []
        if isinstance(capacity, dict):
            items.append(menu_item(
                f"Memory · {capacity['memoryReservedGiB']} / {capacity['memoryBudgetGiB']} GiB (keeps {capacity['memoryHeadroomGiB']} GiB)",
                enabled=False,
            ))
            items.append(menu_item(
                f"CPU · {capacity['cpuReserved']} / {capacity['cpuBudget']} reserved",
                enabled=False,
            ))
            for pool in capacity.get('heldPools', []):
                items.append(menu_item(
                    held_pool_label(pool),
                    None if not pool.get('repository') else f"https://github.com/{pool['repository']}/actions",
                    enabled=bool(pool.get('repository')),
                ))
        if host['_tag'] == 'Available' and host['runners']:
            if items:
                items.append(separator())
            started_map = capacity.get('runnerStartedAt', {}) if isinstance(capacity, dict) else {}
            for runner in sorted(host['runners'], key=runner_label):
                repository = runner['RunnerLabels'].get('com.harlanzw.desktop-runner.repository')
                started_at = started_map.get(runner.get('Names'))
                items.append(menu_item(
                    runner_label(runner, started_at),
                    None if repository is None else f'https://github.com/{repository}/actions',
                    enabled=repository is not None,
                ))
        if not items:
            items.append(menu_item(runner_host_status_label(host), enabled=False))
        if control is not None:
            items.append(separator())
            items.append(menu_item(host_control_status_label(control), enabled=False))
            if control['status'] == 'active':
                control_item = menu_item('Stop accepting new jobs…')
                control_item.connect(
                    'activate',
                    lambda *_args, current=host: confirm_stop_accepting_jobs(current, set_accepting),
                )
                items.append(control_item)
            elif control['status'] in ('inactive', 'failed', 'deactivating'):
                control_item = menu_item('Accept new jobs')
                control_item.connect('activate', lambda *_args, current=host: set_accepting(current, True))
                items.append(control_item)
        menu.append(submenu_item(runner_host_status_label(host), items))

    menu.append(separator())
    refresh_item = menu_item('Refresh')
    refresh_item.connect('activate', lambda *_args: refresh())
    menu.append(refresh_item)
    quit_item = menu_item('Quit')
    quit_item.connect('activate', lambda *_args: Gtk.main_quit())
    menu.append(quit_item)
    menu.show_all()
    indicator.set_menu(menu)


def indicator_summary(source, jobs_source=None):
    if source['_tag'] == 'Loading':
        return ('🟡', 'Loading GitHub Actions')
    runners = source_runners(source)
    status = github_actions_status_label(runners, runner_error(source))
    marker, detail = status.split(' ', 1)
    running = sum(runner.get('Activity', {}).get('_tag') == 'Running' for runner in runners)
    queued = 0
    if isinstance(jobs_source, dict) and jobs_source.get('_tag') == 'Available':
        queued = sum(job.get('_tag') == 'Queued' for job in jobs_source.get('jobs', []))
    held = 0
    if source['_tag'] == 'Available':
        held = sum(
            len(host['capacity'].get('heldPools', []))
            for host in source['hosts']
            if host['_tag'] == 'Available' and isinstance(host.get('capacity'), dict)
        )
    if running:
        label = f'{marker} {running} · {queued}q' if queued else f'{marker} {running}'
    elif held:
        label = f'🟠 {queued}q' if queued else '🟠'
    elif queued:
        label = f'🟡 {queued}q'
    else:
        label = marker
    title_parts = [f'GitHub Actions · {detail}']
    if queued:
        title_parts.append(f'{queued} queued')
    if held:
        title_parts.append(f'{held} held')
    return (label, ' · '.join(title_parts))


def main():
    runner_hosts = parse_runner_hosts(os.environ.get(
        RUNNER_HOSTS_ENV,
        'Desktop=unix:///var/run/docker.sock',
    ))
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    lock = (runtime / 'harlan-github-runner-indicator.lock').open('w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    indicator = AyatanaAppIndicator3.Indicator.new(
        'harlan-github-runners',
        str(RUNNER_ICON),
        AyatanaAppIndicator3.IndicatorCategory.SYSTEM_SERVICES,
    )
    indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
    indicator.set_title('GitHub Actions')
    refreshing = {'active': False}
    pending_action = {'value': None}
    jobs_cache = {'source': {'_tag': 'Loading'}, 'capacities': {}, 'updatedAt': 0.0}
    runner_cache = {'source': None}
    last_signature = {'value': None}

    def attach_capacities(source, capacities):
        if source['_tag'] != 'Available' or not capacities:
            return source
        return {
            '_tag': 'Available',
            'hosts': [
                {**host, 'capacity': capacities[host['name']]}
                if host['_tag'] == 'Available' and host['name'] in capacities
                else host
                for host in source['hosts']
            ],
        }

    def state_signature(source, jobs_source, action_error, label, title):
        # Strip monotonic timestamps so unchanged state does not rebuild the DBusMenu while open.
        if source['_tag'] == 'Available':
            stable_source = {
                '_tag': 'Available',
                'hosts': [
                    {key: value for key, value in host.items() if key != 'observedAt'}
                    for host in source['hosts']
                ],
            }
        else:
            stable_source = source
        return json.dumps([label, title, stable_source, jobs_source, action_error], sort_keys=True)

    def apply_state(source, jobs_source, action_error, complete=True):
        if complete:
            refreshing['active'] = False
        label, title = indicator_summary(source, jobs_source)
        signature = state_signature(source, jobs_source, action_error, label, title)
        if signature != last_signature['value']:
            last_signature['value'] = signature
            indicator.set_label(label, '🟢 99 · 99q')
            indicator.set_icon_full(str(RUNNER_ICON), 'GitHub Actions')
            indicator.set_title(title)
            build_menu(indicator, source, jobs_source, action_error, manual_refresh, change_host_capacity)
        if complete and pending_action['value'] is not None:
            refresh()
        return False

    def load_state():
        action_error = None
        action = pending_action['value']
        pending_action['value'] = None
        if action is not None:
            try:
                set_host_accepting_jobs(action['host'], action['accepting'])
            except Exception as caught:
                action_error = f"{action['host']['name']} · Action required · {caught}"

        current_source = read_runner_source(lambda: request_runner_hosts(runner_hosts))
        source = merge_runner_source(runner_cache['source'], current_source)
        runner_cache['source'] = source
        stale = time.monotonic() - jobs_cache['updatedAt'] >= JOBS_REFRESH_SECONDS
        if stale:
            GLib.idle_add(apply_state, attach_capacities(source, jobs_cache['capacities']), jobs_cache['source'], action_error, False)
            errors = []
            jobs, capacities = request_host_snapshots(runner_hosts, errors.append)
            jobs_cache['source'] = (
                {'_tag': 'Unavailable', 'message': '\n'.join(errors)}
                if errors and not jobs
                else {'_tag': 'Available', 'jobs': jobs, 'errors': errors}
            )
            jobs_cache['capacities'] = capacities
            jobs_cache['updatedAt'] = time.monotonic()
        GLib.idle_add(apply_state, attach_capacities(source, jobs_cache['capacities']), jobs_cache['source'], action_error, True)

    def refresh(*_args):
        if refreshing['active']:
            return True
        refreshing['active'] = True
        threading.Thread(target=load_state, daemon=True).start()
        return True

    def manual_refresh(*_args):
        jobs_cache['updatedAt'] = 0.0
        return refresh()

    def change_host_capacity(host, accepting):
        pending_action['value'] = {
            'host': host,
            'accepting': accepting,
        }
        jobs_cache['updatedAt'] = 0.0
        return refresh()

    build_menu(
        indicator,
        {'_tag': 'Loading'},
        {'_tag': 'Loading'},
        None,
        manual_refresh,
        change_host_capacity,
    )
    refresh()
    GLib.timeout_add_seconds(15, refresh)
    Gtk.main()


if __name__ == '__main__':
    main()
