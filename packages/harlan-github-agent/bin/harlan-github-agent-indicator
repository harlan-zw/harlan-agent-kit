#!/usr/bin/python3

import base64
import fcntl
import json
import os
import selectors
import sqlite3
import subprocess
import sys
import threading
import time
import urllib.request
import webbrowser
from pathlib import Path

import gi

gi.require_version('AyatanaAppIndicator3', '0.1')
gi.require_version('Gtk', '3.0')
from gi.repository import AyatanaAppIndicator3, GLib, Gtk

DASHBOARD_URL = 'https://harlan-github-agent.localhost/'
DASHBOARD_API = f'{DASHBOARD_URL}api/state'
DASHBOARD_ORIGIN = DASHBOARD_URL.rstrip('/')
PASSWORD_FILE = Path.home() / '.config/harlan-github-agent/dashboard-password'
APP_ICON = Path(__file__).resolve().parent.parent / 'assets/github-app-icon.png'
WATCHER = Path(__file__).resolve().parent / 'harlan-github-agent-watch'
WEEKLY_LIMIT_MINS = 7 * 24 * 60
WEEKLY_SECONDS = 7 * 24 * 60 * 60
CODEX_LIMIT_REFRESH_SECONDS = 60
OPENCODE_DATABASE = Path.home() / '.local/share/opencode/opencode.db'
PROVIDER_LABELS = {
    'codex': 'Codex',
    'opencode': 'opencode',
}
AGENT_MODELS = {
    'codex': ['gpt-5.6-sol', 'gpt-5.6-terra', 'gpt-5.6-luna'],
    'opencode': ['opencode-go/deepseek-v4-flash', 'opencode-go/deepseek-v4-pro'],
}
REASONING_EFFORTS = ['none', 'low', 'medium', 'high', 'xhigh', 'max']
PROVIDER_DEFAULT_LABEL = 'Provider default'
FOLLOW_CONFIGURATION_LABEL = 'Follow configuration'
AUTOMATIC_LABEL = 'Automatic'
AGENT_ROLE_LABELS = {
    'adversarial_review': 'Adversarial review',
    'baseline_repair': 'Baseline repair',
    'conflict_resolution': 'Conflict resolution',
    'issue_triage': 'Issue triage',
    'issue_work': 'Issue work',
    'review_fix': 'Repair',
}


def dashboard_authorization():
    password = PASSWORD_FILE.read_text().rstrip('\n')
    credentials = base64.b64encode(f'agent:{password}'.encode()).decode()
    return f'Basic {credentials}'


def request_dashboard():
    request = urllib.request.Request(DASHBOARD_API, headers={'Authorization': dashboard_authorization()})
    with urllib.request.urlopen(request, timeout=3) as response:
        return json.load(response)


def request_agent_control(action):
    if action not in ('pause', 'resume'):
        raise ValueError(f'Unsupported agent control action: {action}')
    request = urllib.request.Request(
        f'{DASHBOARD_URL}api/agents/{action}',
        data=b'',
        method='POST',
        headers={
            'Authorization': dashboard_authorization(),
            'Origin': DASHBOARD_ORIGIN,
        },
    )
    with urllib.request.urlopen(request, timeout=3) as response:
        return json.load(response)


def request_agent_select(selection):
    request = urllib.request.Request(
        f'{DASHBOARD_URL}api/agents/select',
        data=json.dumps(selection, separators=(',', ':')).encode(),
        method='POST',
        headers={
            'Authorization': dashboard_authorization(),
            'Content-Type': 'application/json',
            'Origin': DASHBOARD_ORIGIN,
        },
    )
    with urllib.request.urlopen(request, timeout=3) as response:
        return json.load(response)


def request_agent_eject(task_id):
    request = urllib.request.Request(
        f'{DASHBOARD_URL}api/agents/eject',
        data=json.dumps({'taskId': task_id}, separators=(',', ':')).encode(),
        method='POST',
        headers={
            'Authorization': dashboard_authorization(),
            'Content-Type': 'application/json',
            'Origin': DASHBOARD_ORIGIN,
        },
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


def read_system_sources(fetch_dashboard):
    try:
        harlan_github_agent = {'_tag': 'Available', 'dashboard': fetch_dashboard()}
    except Exception as caught:
        harlan_github_agent = {'_tag': 'Unavailable', 'message': str(caught)}

    return {
        'harlanGithubAgent': harlan_github_agent,
    }


def loading_system_sources():
    return {
        'harlanGithubAgent': {'_tag': 'Loading'},
    }


def source_dashboard(sources):
    source = sources['harlanGithubAgent']
    return source['dashboard'] if source['_tag'] == 'Available' else None


def active_provider(dashboard):
    if dashboard is None:
        return None
    profile = dashboard.get('agentProfile') or {}
    provider = profile.get('provider')
    return provider if isinstance(provider, str) else None


def agent_provider_label(dashboard):
    provider = active_provider(dashboard)
    if provider is None:
        return 'Agent provider · Loading…'
    profile = dashboard.get('agentProfile') or {}
    review = (profile.get('roles') or {}).get('adversarial_review') or {}
    model = review.get('model', 'unknown model')
    effort = review.get('reasoningEffort')
    name = PROVIDER_LABELS.get(provider, provider)
    return f"Agent provider · {name} · {model}{f' · {effort}' if effort else ''}"


def agent_selection(dashboard):
    """Reads the Agent selection: a pinned provider, or the configuration."""
    if dashboard is None:
        return None
    selection = dashboard.get('agentSelection')
    if not isinstance(selection, dict):
        return None
    if selection.get('_tag') == 'FollowsConfiguration':
        return {'_tag': 'FollowsConfiguration'}
    if selection.get('_tag') == 'Automatic':
        order = selection.get('order')
        return {'_tag': 'Automatic', 'order': order if isinstance(order, list) else []}
    if selection.get('_tag') != 'Pinned' or not isinstance(selection.get('provider'), str):
        return None
    return {
        '_tag': 'Pinned',
        'provider': selection['provider'],
        'model': selection.get('model'),
        'reasoningEffort': selection.get('reasoningEffort'),
    }


def selection_marker(selected):
    return '●' if selected else '○'


def agent_selection_choices(selection, provider):
    """Lists every Agent provider, model, and reasoning effort the menu offers.

    Switching the provider clears the model and the reasoning effort, because a
    model belongs to one provider and the service refuses the other provider's.
    Follow configuration gives the whole choice back to the configuration file.

    `provider` is the Agent provider in force. While the selection follows the
    configuration, that provider owns the models the menu lists.
    """
    if selection is None or provider is None:
        return []
    pinned = selection if selection.get('_tag') == 'Pinned' else None

    def choice(label, selected, chosen):
        return {'_tag': 'Choice', 'label': label, 'selected': selected, 'selection': chosen}

    def pin(model, effort):
        return {'_tag': 'Pinned', 'provider': provider, 'model': model, 'reasoningEffort': effort}

    model = pinned['model'] if pinned else None
    effort = pinned['reasoningEffort'] if pinned else None

    choices = [{'_tag': 'Heading', 'label': 'Agent provider'}]
    choices.append(choice(
        FOLLOW_CONFIGURATION_LABEL,
        selection.get('_tag') == 'FollowsConfiguration',
        {'_tag': 'FollowsConfiguration'},
    ))
    choices.append(choice(
        AUTOMATIC_LABEL,
        selection.get('_tag') == 'Automatic',
        {'_tag': 'Automatic', 'order': list(AGENT_MODELS)},
    ))
    choices.extend(
        choice(
            PROVIDER_LABELS.get(candidate, candidate),
            pinned is not None and pinned['provider'] == candidate,
            {'_tag': 'Pinned', 'provider': candidate, 'model': None, 'reasoningEffort': None},
        )
        for candidate in AGENT_MODELS
    )

    choices.append({'_tag': 'Separator'})
    choices.append({'_tag': 'Heading', 'label': 'Model'})
    choices.extend(
        choice(candidate or PROVIDER_DEFAULT_LABEL, model == candidate, pin(candidate, effort))
        for candidate in [None, *AGENT_MODELS.get(provider, [])]
    )

    choices.append({'_tag': 'Separator'})
    choices.append({'_tag': 'Heading', 'label': 'Reasoning effort'})
    choices.extend(
        choice(candidate or PROVIDER_DEFAULT_LABEL, effort == candidate, pin(model, candidate))
        for candidate in [None, *REASONING_EFFORTS]
    )
    return choices


def agent_selection_items(dashboard, select_agent):
    choices = agent_selection_choices(agent_selection(dashboard), active_provider(dashboard))
    if not choices:
        return [menu_item('Agent selection unavailable', enabled=False)]
    items = []
    for entry in choices:
        if entry['_tag'] == 'Separator':
            items.append(separator())
        elif entry['_tag'] == 'Heading':
            items.append(menu_item(entry['label'], enabled=False))
        else:
            item = menu_item(f"{selection_marker(entry['selected'])} {entry['label']}")
            item.connect('activate', lambda *_args, value=entry['selection']: select_agent(value))
            items.append(item)
    return items


def opencode_usage(now=None, database=OPENCODE_DATABASE):
    """opencode publishes no quota, so report what its own store knows: spend."""
    since = int(((time.time() if now is None else now) - WEEKLY_SECONDS) * 1000)
    connection = sqlite3.connect(f'file:{database}?mode=ro', uri=True, timeout=2)
    try:
        row = connection.execute(
            """
            SELECT
              COUNT(*),
              COALESCE(SUM(COALESCE(json_extract(data, '$.cost'), 0)), 0),
              COALESCE(SUM(
                COALESCE(json_extract(data, '$.tokens.input'), 0)
                + COALESCE(json_extract(data, '$.tokens.output'), 0)
              ), 0)
            FROM message
            WHERE json_extract(data, '$.role') = 'assistant' AND time_created > ?
            """,
            (since,),
        ).fetchone()
    finally:
        connection.close()
    return {'_tag': 'Available', 'turns': row[0], 'cost': row[1], 'tokens': row[2]}


def format_tokens(tokens):
    if tokens >= 1_000_000:
        return f'{tokens / 1_000_000:.1f}M'
    if tokens >= 1_000:
        return f'{tokens / 1_000:.1f}K'
    return str(int(tokens))


def opencode_usage_label(usage):
    if usage is None:
        return 'Weekly opencode usage · Loading…'
    if usage.get('_tag') != 'Available':
        return 'Weekly opencode usage unavailable'
    return (
        f"Weekly opencode usage · ${usage['cost']:.2f} · "
        f"{format_tokens(usage['tokens'])} tokens · {usage['turns']} turns"
    )


def weekly_codex_limit(response):
    limits = response.get('rateLimitsByLimitId', {}).get('codex') or response.get('rateLimits', {})
    window = next((
        candidate
        for candidate in (limits.get('primary'), limits.get('secondary'))
        if candidate is not None and candidate.get('windowDurationMins') == WEEKLY_LIMIT_MINS
    ), None)
    if window is None or not isinstance(window.get('usedPercent'), (int, float)) or not isinstance(window.get('resetsAt'), (int, float)):
        return {'_tag': 'Unavailable'}
    return {
        '_tag': 'Available',
        'usedPercent': window['usedPercent'],
        'resetsAt': window['resetsAt'],
    }


def codex_limit_label(limit, now=None):
    if limit is None:
        return 'Weekly Codex limit · Loading…'
    if limit.get('_tag') != 'Available':
        return 'Weekly Codex limit unavailable'
    remaining = max(0, min(100, int(100 - limit['usedPercent'] + 0.5)))
    seconds = max(0, int(limit['resetsAt'] - (time.time() if now is None else now)))
    days, day_seconds = divmod(seconds, 86400)
    hours, hour_seconds = divmod(day_seconds, 3600)
    minutes = hour_seconds // 60
    if days > 0:
        reset = f'{days}d {hours}h'
    elif hours > 0:
        reset = f'{hours}h {minutes}m'
    elif minutes > 0:
        reset = f'{minutes}m'
    else:
        reset = 'now'
    return f'Weekly Codex limit · {remaining}% left · resets in {reset}'


def request_codex_limit(timeout=10):
    process = subprocess.Popen(
        ['codex', 'app-server'],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )
    selector = selectors.DefaultSelector()
    try:
        selector.register(process.stdout, selectors.EVENT_READ)

        def send(message):
            process.stdin.write(f'{json.dumps(message, separators=(",", ":"))}\n')
            process.stdin.flush()

        send({
            'method': 'initialize',
            'id': 0,
            'params': {
                'clientInfo': {
                    'name': 'harlan_github_agent_indicator',
                    'title': 'Harlan GitHub Agent Indicator',
                    'version': '0.1.0',
                },
            },
        })
        deadline = time.monotonic() + timeout
        initialized = False
        while time.monotonic() < deadline:
            events = selector.select(deadline - time.monotonic())
            if not events:
                break
            line = process.stdout.readline()
            if not line:
                break
            message = json.loads(line)
            if message.get('id') == 0 and not initialized:
                if 'error' in message:
                    raise RuntimeError(message['error'].get('message', 'Codex initialization failed.'))
                initialized = True
                send({'method': 'initialized', 'params': {}})
                send({'method': 'account/rateLimits/read', 'id': 1})
            if message.get('id') == 1:
                if 'error' in message:
                    raise RuntimeError(message['error'].get('message', 'Codex limits are unavailable.'))
                return weekly_codex_limit(message.get('result', {}))
        raise TimeoutError('Codex limits request timed out.')
    finally:
        selector.close()
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=1)


def open_url(url):
    return lambda *_args: webbrowser.open(url)


def open_agent_watch(agent):
    session = agent.get('session', {})
    if session.get('_tag') != 'Connected':
        return
    subprocess.Popen([
        '/usr/bin/ghostty',
        f"--title=Watch logs · {agent['repository']} #{agent['itemNumber']}",
        '-e',
        sys.executable,
        str(WATCHER),
        agent['provider'],
        session['id'],
    ], start_new_session=True)


def menu_item(label, url=None, enabled=True):
    item = Gtk.MenuItem(label=label)
    item.set_sensitive(enabled)
    if url is not None:
        item.connect('activate', open_url(url))
    item.show()
    return item


def submenu_item(label, items):
    item = menu_item(label)
    submenu = Gtk.Menu()
    for child in items:
        submenu.append(child)
    submenu.show_all()
    item.set_submenu(submenu)
    return item


def section_item(label):
    item = Gtk.MenuItem()
    text = Gtk.Label()
    text.set_markup(f'<b>{GLib.markup_escape_text(label)}</b>')
    text.set_xalign(0)
    item.add(text)
    item.set_sensitive(False)
    item.show_all()
    return item


def separator():
    item = Gtk.SeparatorMenuItem()
    item.show()
    return item


def progress_bar(percent):
    complete = min(5, max(0, int(percent / 20 + 0.5)))
    return f"{'▓' * complete}{'░' * (5 - complete)}"


def agent_role_label(agent):
    return AGENT_ROLE_LABELS[agent['role']]


def active_agent_label(agent):
    progress = agent.get('progress', {'percent': 0, 'label': 'Starting'})
    return (
        f"{progress_bar(progress['percent'])}  {progress['percent']}% · "
        f"{agent_role_label(agent)} · {agent['repository']} #{agent['itemNumber']}"
    )


def confirm_agent_eject(agent, eject_agent):
    dialog = Gtk.MessageDialog(
        transient_for=None,
        flags=0,
        message_type=Gtk.MessageType.WARNING,
        buttons=Gtk.ButtonsType.CANCEL,
        text=f"Eject {agent['repository']} #{agent['itemNumber']}?",
    )
    dialog.format_secondary_text('Automation stops. Ghostty resumes the saved Codex session.')
    dialog.add_button('Eject', Gtk.ResponseType.OK)
    response = dialog.run()
    dialog.destroy()
    if response == Gtk.ResponseType.OK:
        eject_agent(agent['id'])


def queue_state(entry):
    labels = {
        'Active': '🟢 Running',
        'AwaitingApproval': '🟠 Approval needed',
        'ActionRequired': '🔴 Action required',
        'Queued': '🔵 Queued',
        'Pending': '🟡 Pending',
    }
    return labels.get(entry.get('state', {}).get('_tag'), '🟡 Pending')


def agent_control_action(agent_control):
    if agent_control.get('_tag') == 'Paused':
        return ('▶ Resume agents', 'resume')
    return ('⏸ Pause agents', 'pause')


def selection_mode_label(dashboard):
    """Manual Selection mode holds every pull request, so the tray has to say so."""
    if dashboard.get('selectionMode') == 'manual':
        return '🟠 Manual selection · select a pull request in the dashboard'
    return None


def counted(count, singular, plural=None):
    return f'{count} {singular if count == 1 else plural or f"{singular}s"}'


def queue_count_label(queue):
    return 'Queue empty' if not queue else f'{len(queue)} in Queue'


def dashboard_attention(dashboard):
    incidents = dashboard.get('incidents', [])
    queue = dashboard.get('queue', [])
    if dashboard.get('status') == 'degraded' or any(
        incident.get('recovery', {}).get('_tag') in ('Exhausted', 'ActionRequired')
        for incident in incidents
    ) or any(entry.get('state', {}).get('_tag') == 'ActionRequired' for entry in queue):
        return {'_tag': 'ActionRequired'}

    approvals = sum(
        entry.get('state', {}).get('_tag') == 'AwaitingApproval'
        for entry in queue
    )
    if approvals > 0:
        return {'_tag': 'ApprovalRequired', 'count': approvals}
    if incidents:
        return {'_tag': 'Retrying'}
    return {'_tag': 'Clear'}


def indicator_summary(dashboard, agents, error):
    if error is not None:
        return ('🔴', 'Harlan GitHub Agent unavailable')
    if dashboard is None:
        return ('🟡', 'Loading Harlan GitHub Agent')

    queue_label = queue_count_label(dashboard.get('queue', []))
    attention = dashboard_attention(dashboard)
    if attention['_tag'] == 'ActionRequired':
        return ('🔴', 'Harlan GitHub Agent · Action required')
    if dashboard.get('agentControl', {}).get('_tag') == 'Paused':
        parts = ['Agents paused']
        if agents:
            parts.append(counted(len(agents), 'agent finishing', 'agents finishing'))
        parts.append(queue_label)
        return ('🟡', ' · '.join(parts))
    if attention['_tag'] == 'ApprovalRequired':
        approvals = counted(attention['count'], 'approval needed', 'approvals needed')
        return ('🟡', f'{approvals} · {queue_label}')
    if attention['_tag'] == 'Retrying':
        return ('🟠', f'Harlan GitHub Agent retrying · {queue_label}')

    marker = f'🟢 {len(agents)}' if agents else '⚪'
    title = ' · '.join((counted(len(agents), 'agent running', 'agents running'), queue_label))
    return (marker, title)


def harlan_github_agent_status_label(dashboard, agents, error):
    if error is not None:
        return '🔴 Unavailable'
    if dashboard is None:
        return '🟡 Loading…'

    queue_label = queue_count_label(dashboard.get('queue', []))
    attention = dashboard_attention(dashboard)
    agent_control = dashboard.get('agentControl', {'_tag': 'Running'})
    if attention['_tag'] == 'ActionRequired':
        return f'🔴 Action required · {queue_label}'
    if agent_control.get('_tag') == 'Paused':
        finishing = counted(len(agents), 'agent finishing', 'agents finishing')
        return f'🟡 Paused · {finishing} · {queue_label}'
    if attention['_tag'] == 'ApprovalRequired':
        approvals = counted(attention['count'], 'approval needed', 'approvals needed')
        return f'🟡 {approvals} · {queue_label}'
    if attention['_tag'] == 'Retrying':
        return f'🟠 Retrying · {queue_label}'
    if agents:
        running = counted(len(agents), 'agent running', 'agents running')
        return f'🟢 {running} · {queue_label}'
    return f'⚪ Idle · {queue_label}'


def incident_scope_label(incident):
    scope = incident.get('scope', {})
    if scope.get('_tag') == 'Repository':
        return scope.get('repository', 'Unknown repository')
    if scope.get('_tag') == 'Task':
        repository = scope.get('repository', 'Unknown repository')
        number = scope.get('itemNumber')
        return repository if number is None else f'{repository} #{number}'
    return 'Harlan GitHub Agent'


def incident_recovery_label(incident):
    recovery = incident.get('recovery', {})
    if recovery.get('_tag') == 'Retrying':
        return 'Retrying'
    if recovery.get('_tag') == 'Exhausted':
        return 'Retries exhausted'
    return 'Action required'


def incident_label(incident):
    marker = '🔴' if incident.get('severity') == 'error' else '🟠'
    message = incident.get('message', 'Incident details unavailable')[:80]
    return f'{marker} {incident_recovery_label(incident)} · {incident_scope_label(incident)} · {message}'


def incident_url(incident):
    scope = incident.get('scope', {})
    repository = scope.get('repository')
    return None if repository is None else f'https://github.com/{repository}'


def usage_label(dashboard, usage):
    return opencode_usage_label(usage) if active_provider(dashboard) == 'opencode' else codex_limit_label(usage)


def build_menu(indicator, sources, usage, action_error, refresh, set_agent_control, eject_agent, select_agent):
    menu = Gtk.Menu()
    dashboard_source = sources['harlanGithubAgent']
    dashboard = source_dashboard(sources)
    dashboard_error = dashboard_source.get('message') if dashboard_source['_tag'] == 'Unavailable' else None
    agents = [] if dashboard is None else [agent for agent in dashboard.get('agents', []) if agent.get('_tag') == 'ActiveAgent']
    queue = [] if dashboard is None else dashboard.get('queue', [])
    menu.append(section_item('Harlan GitHub Agent'))
    menu.append(menu_item(harlan_github_agent_status_label(dashboard, agents, dashboard_error), enabled=False))
    if dashboard_error is not None:
        menu.append(menu_item(dashboard_error[:100], enabled=False))
    if action_error is not None:
        menu.append(menu_item(action_error[:100], enabled=False))
    menu.append(menu_item('Open dashboard', DASHBOARD_URL))

    if dashboard is not None:
        menu.append(menu_item(usage_label(dashboard, usage), enabled=False))
        agent_control = dashboard.get('agentControl', {'_tag': 'Running'})
        selection_label = selection_mode_label(dashboard)
        if selection_label is not None:
            menu.append(menu_item(selection_label, enabled=False))
        for agent in agents:
            progress = agent.get('progress', {'percent': 0, 'label': 'Starting'})
            kind = 'issue' if agent.get('subjectKind') == 'issue' else 'pull request'
            links = [
                menu_item(progress['label'], enabled=False),
                menu_item(f'Open {kind}', agent['subjectUrl']),
            ]
            if agent.get('commitUrl'):
                links.append(menu_item('Open head commit', agent['commitUrl']))
            watch_item = menu_item('Watch logs', enabled=agent.get('session', {}).get('_tag') == 'Connected')
            watch_item.connect('activate', lambda *_args, current=agent: open_agent_watch(current))
            links.append(watch_item)
            eject_item = menu_item('Eject into terminal…', enabled=agent.get('session', {}).get('_tag') == 'Connected')
            eject_item.connect('activate', lambda *_args, current=agent: confirm_agent_eject(current, eject_agent))
            links.append(eject_item)
            menu.append(submenu_item(active_agent_label(agent), links))

        incidents = dashboard.get('incidents', [])
        if incidents:
            menu.append(submenu_item(
                f'Incidents · {len(incidents)}',
                [
                    menu_item(
                        incident_label(incident),
                        incident_url(incident),
                        enabled=incident_url(incident) is not None,
                    )
                    for incident in incidents
                ],
            ))

        if queue:
            queue_items = [
                menu_item(f"{entry['position']} · {entry['repository']} #{entry['number']} · {queue_state(entry)}", entry['subjectUrl'])
                for entry in queue[:10]
            ]
            if len(queue) > 10:
                queue_items.append(menu_item(f'Open dashboard for {len(queue) - 10} more', DASHBOARD_URL))
            menu.append(submenu_item(
                f'Queue · {len(queue)}',
                queue_items,
            ))
        menu.append(submenu_item(agent_provider_label(dashboard), agent_selection_items(dashboard, select_agent)))
        control_label, action = agent_control_action(dashboard.get('agentControl', {'_tag': 'Running'}))
        control_item = menu_item(control_label)
        control_item.connect('activate', lambda *_args: set_agent_control(action))
        menu.append(control_item)

    menu.append(separator())
    refresh_item = menu_item('Refresh')
    refresh_item.connect('activate', lambda *_args: refresh())
    menu.append(refresh_item)
    quit_item = menu_item('Quit')
    quit_item.connect('activate', lambda *_args: Gtk.main_quit())
    menu.append(quit_item)
    menu.show_all()
    indicator.set_menu(menu)


def main():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    lock = (runtime / 'harlan-github-agent-indicator.lock').open('w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    indicator = AyatanaAppIndicator3.Indicator.new(
        'harlan-github-agent',
        str(APP_ICON),
        AyatanaAppIndicator3.IndicatorCategory.SYSTEM_SERVICES,
    )
    indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
    indicator.set_title('Harlan GitHub Agent')
    refreshing = {'active': False}
    pending_action = {'value': None}
    usage_cache = {'value': None, 'updatedAt': 0.0, 'provider': None}

    def apply_state(sources, usage, control_error):
        refreshing['active'] = False
        dashboard = source_dashboard(sources)
        agents = [] if dashboard is None else [agent for agent in dashboard.get('agents', []) if agent.get('_tag') == 'ActiveAgent']
        dashboard_source = sources['harlanGithubAgent']
        dashboard_error = dashboard_source.get('message') if dashboard_source['_tag'] == 'Unavailable' else None
        label, title = indicator_summary(dashboard, agents, dashboard_error)
        indicator.set_label(label, '🟢 99')
        indicator.set_icon_full(str(APP_ICON), 'Harlan GitHub Agent')
        indicator.set_title(title)
        build_menu(indicator, sources, usage, control_error, refresh, set_agent_control, eject_agent, select_agent)
        if pending_action['value'] is not None:
            refresh()
        return False

    def load_state():
        control_error = None
        action = pending_action['value']
        pending_action['value'] = None
        if action is not None:
            try:
                if action['_tag'] == 'AgentControl':
                    request_agent_control(action['action'])
                elif action['_tag'] == 'AgentSelect':
                    request_agent_select(action['selection'])
                else:
                    request_agent_eject(action['taskId'])
            except Exception as caught:
                control_error = f"{action['label']} failed: {caught}"
        sources = read_system_sources(request_dashboard)
        dashboard = source_dashboard(sources)
        provider = active_provider(dashboard)
        stale = time.monotonic() - usage_cache['updatedAt'] >= CODEX_LIMIT_REFRESH_SECONDS
        if provider is not None and (stale or usage_cache['provider'] != provider):
            try:
                usage_cache['value'] = opencode_usage() if provider == 'opencode' else request_codex_limit()
            except Exception:
                usage_cache['value'] = {'_tag': 'Unavailable'}
            usage_cache['provider'] = provider
            usage_cache['updatedAt'] = time.monotonic()
        GLib.idle_add(apply_state, sources, usage_cache['value'], control_error)

    def refresh(*_args):
        if refreshing['active']:
            return True
        refreshing['active'] = True
        threading.Thread(target=load_state, daemon=True).start()
        return True

    def set_agent_control(action):
        pending_action['value'] = {
            '_tag': 'AgentControl',
            'action': action,
            'label': action.capitalize(),
        }
        return refresh()

    def select_agent(selection):
        pending_action['value'] = {
            '_tag': 'AgentSelect',
            'selection': selection,
            'label': 'Agent switch',
        }
        return refresh()

    def eject_agent(task_id):
        pending_action['value'] = {
            '_tag': 'AgentEject',
            'taskId': task_id,
            'label': 'Eject',
        }
        return refresh()

    build_menu(indicator, loading_system_sources(), None, None, refresh, set_agent_control, eject_agent, select_agent)
    refresh()
    GLib.timeout_add_seconds(5, refresh)
    Gtk.main()


if __name__ == '__main__':
    main()
