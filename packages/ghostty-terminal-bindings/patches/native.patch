+
+/// Return flags from the authoritative active-screen keyboard stack.
+pub fn getKittyKeyboardFlags(ptr: ?*anyopaque) callconv(.c) u8 {
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return 0));
+    return @intCast(wrapper.terminal.screens.active.kitty_keyboard.current().int());
+}
+
+/// Packed keyboard options. Bits 0..4 are Kitty flags; bits 8..12 are modes.
+pub fn getKeyEncoderOptions(ptr: ?*anyopaque) callconv(.c) u32 {
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return 0));
+    const opts = @import("../../input/key_encode.zig").Options.fromTerminal(&wrapper.terminal);
+    var value: u32 = opts.kitty_flags.int();
+    if (opts.cursor_key_application) value |= 1 << 8;
+    if (opts.keypad_key_application) value |= 1 << 9;
+    if (opts.ignore_keypad_with_numlock) value |= 1 << 10;
+    if (opts.alt_esc_prefix) value |= 1 << 11;
+    if (opts.modify_other_keys_state_2) value |= 1 << 12;
+    return value;
+}
