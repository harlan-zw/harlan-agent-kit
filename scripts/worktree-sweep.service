[Unit]
Description=Remove clean integrated Git worktrees older than one day

[Service]
Type=oneshot
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/git-worktree-sweep --apply --days 1 %h
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true

